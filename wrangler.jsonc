{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencode-durable-object",
  "main": "src/index.ts",
  "minify": true,
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "OPENCODE",
        "class_name": "OpenCodeDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OpenCodeDO"]
    }
  ]
}
