{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencode-durable-object",
  "main": "packages/server/src/index.ts",
  "minify": true,
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "ocx" }],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.generated.txt"],
      "fallthrough": true
    },
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OPENCODE",
        "class_name": "OpenCodeDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OpenCodeDO"]
    }
  ]
}
