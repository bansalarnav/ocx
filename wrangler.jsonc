{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencode-durable-object",
  "main": "packages/server/src/index.ts",
  "minify": true,
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
    "nodejs_compat",
    "experimental"
  ],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OPENCODE",
        "class_name": "OpenCodeDO"
      },
      {
        "name": "COMPUTERS",
        "class_name": "RemoteComputer"
      },
      {
        "name": "WORKSPACES",
        "class_name": "WorkspaceCatalog"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OpenCodeDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "RemoteComputer",
        "WorkspaceCatalog"
      ]
    }
  ],
  "worker_loaders": [{ "binding": "LOADER" }]
}
