{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "plugin-bundler-smoke",
  "main": "bundler-smoke.worker.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ]
}
